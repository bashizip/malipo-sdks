{
  "name": "malipo-node",
  "version": "1.2.3",
  "description": "Official Node.js SDK for Malipo Payment Gateway",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "malipo",
    "payments",
    "sdk",
    "dr-congo",
    "mobile-money"
  ],
  "author": "Malipo Team",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.3.6",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
