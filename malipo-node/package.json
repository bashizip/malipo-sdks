{
  "name": "malipo-node",
  "version": "1.2.5",
  "description": "Official Node.js SDK for Malipo Payment Gateway",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "test:acceptance": "npm run build && node --test scripts/b2c-acceptance.check.mjs",
    "test:b2c:staging": "node scripts/test-b2c-staging.mjs",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "malipo",
    "payments",
    "sdk",
    "dr-congo",
    "mobile-money"
  ],
  "author": "Malipo Team",
  "license": "MIT",
  "homepage": "https://docs.malipo.dev/sdk/node/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bashizip/malipo-sdks.git",
    "directory": "malipo-node"
  },
  "bugs": {
    "url": "https://github.com/bashizip/malipo-sdks/issues"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.3.6",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
